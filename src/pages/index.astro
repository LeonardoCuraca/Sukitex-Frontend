					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import "@splidejs/splide/css";
	import { Splide } from "@splidejs/splide";
	import { AutoScroll } from "@splidejs/splide-extension-auto-scroll";

	new Splide("#carousel", {
		type: "loop",
		classes: {
			arrows: "splide__arrows your-class-arrows",
			arrow : "splide__arrow your-class-arrow !bg-transparent [&>svg]:!fill-white",
			prev  : "splide__arrow--prev your-class-prev",
			next  : "splide__arrow--next your-class-next",
		},
		breakpoints: {
			640: { arrows: false }
		}
	}).mount();

	new Splide("#services", {
		type: "loop",
		autoplay: true,
		perPage: 4,
		interval: 3000,
		perMove: 1,
		gap: "4rem",
		pagination: false,
		arrows: false,
		breakpoints: {
			640: { perPage: 1 },
			1024: { perPage: 2 },
			1280: { perPage: 3 },
			1536: { perPage: 4 }
		}
	}).mount();

	new Splide("#slider", {
		type: "loop",
		perPage: 5,
		gap: "1.5rem",
		pagination: false,
		arrows: false
	}).mount( { AutoScroll } );
</script>