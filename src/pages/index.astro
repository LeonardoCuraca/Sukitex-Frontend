					</div>
					<div class="aspect-[4/3]">
						<Image src="https://mohair.qodeinteractive.com/wp-content/uploads/2023/04/blog-img-16.jpg" alt="Experts" class="h-full w-full object-cover" width="600" height="600" loading="eager" />
					</div>
					<div class="aspect-video">
