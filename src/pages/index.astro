								<p class="font-ibarra italic text-gray-400">Custom Tailored</p>
							</div>
						</div>
						<div class="splide__slide">
							<div class="aspect-[2/3] relative mb-6">
								<Image src="/img/marketing.png" alt="Sewing Machine" class="h-full w-full object-cover rounded-t-full" width="800" height="1200" loading="eager" />
							</div>
							<div class="text-center">
