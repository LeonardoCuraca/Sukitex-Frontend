					</div>
				</div>
			</div>
		</section>

		<hr>

		<section class="py-24">
			<div class="container mx-auto">
				<div class="text-center mb-24">
					<p class="font-ibarra italic text-xl">"Comprometidos a brindar la mejor calidad a nuestros clientes"</p>
				</div>
				
				<div id="slider" class="splide" aria-label="Slider">
					<div class="splide__track">
						<div class="absolute top-0 start-0 h-full w-full bg-gradient-to-r from-white to-transparent to-5% z-10"></div>
						<div class="absolute top-0 start-0 h-full w-full bg-gradient-to-l from-white to-transparent to-5% z-10"></div>
						<div class="splide__list items-center">
							<div class="splide__slide">
								<Image src="https://hubhtml.liquid-themes.com/assets/images/demo/company/client-dropcam-1.svg" alt="dropcam" width="121" height="23" loading="eager">
							</div>
							<div class="splide__slide">
								<Image src="https://hubhtml.liquid-themes.com/assets/images/demo/company/client-digitallogo-1.svg" alt="digitallogo" width="121" height="23" loading="eager">
							</div>
							<div class="splide__slide">
								<Image src="https://hubhtml.liquid-themes.com/assets/images/demo/company/client-logo-7-2.svg" alt="Apper" width="80" height="64" loading="eager">
							</div>
							<div class="splide__slide">
								<Image src="https://hubhtml.liquid-themes.com/assets/images/demo/company/client-yahoofinance-2.svg" alt="yahoofinance" width="86" height="31" loading="eager">
							</div>
							<div class="splide__slide">
								<Image src="https://hubhtml.liquid-themes.com/assets/images/demo/company/client-dhl-2.svg" alt="dhl" width="80" height="11" loading="eager">
							</div>
							<div class="splide__slide">
								<Image src="https://hubhtml.liquid-themes.com/assets/images/demo/company/client-entr-2.svg" alt="entr" width="118" height="23" loading="eager">
