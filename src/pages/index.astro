							</div>
						</div>
						<div class="splide__slide">
							<div class="aspect-[2/3] relative mb-6">
								<Image src="/img/promocion.png" alt="Sewing Machine" class="h-full w-full object-cover" width="800" height="1200" loading="eager" />
							</div>
							<div class="text-center">
								<h2 class="text-2xl">Casacas de Promoción</h2>
